# Web
HOST=0.0.0.0
PORT=5000
DEBUG=1

# SSH tunnel (preferred way to reach the DB)
USE_SSH_TUNNEL=1

SSH_HOST=blue.cs.sonoma.edu
SSH_PORT=22
SSH_USER=sshaw
SSH_PASSWORD=gluedGorilla101
# If you switch to key auth later, set SSH_PKEY to your private key path and remove SSH_PASSWORD
# SSH_PKEY=/home/youruser/.ssh/id_ed25519

# Where the DB lives as seen FROM the SSH host
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=3306

# Let the tunnel choose a free local port and the app will rewrite DB_PORT automatically
LOCAL_TUNNEL_PORT=0

# DB baseline (these get overridden once the tunnel starts)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=SDD_003_user
DB_PASSWORD=SDD_003_29
DB_NAME=SDD_003_database




# Kroger OAuth + API
KROGER_CLIENT_ID=grocoloco-bbc9tt6z
KROGER_CLIENT_SECRET=NJFzhh2LM3leUUkISCtgdyRmgYS7axBcrPCwW5i2

# Use Kroger CERT environment
KROGER_BASE=https://api-ce.kroger.com


# gives product search permission too
KROGER_SCOPE=product.compact

# space-separated scopes for client-credentials flow
# product.compact is required for products; location.compact for store search
KROGER_SCOPES_CLIENT=product.compact

# optional: for cart (authorization_code)
KROGER_SCOPES_USER=profile.compact cart.basic:write
KROGER_REDIRECT_URI=http://localhost:5000/oauth/callback   # change if you like



