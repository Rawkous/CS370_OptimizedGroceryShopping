    MYSQL_DB = "SDD_003_database"

    local_port = 3307  # Local forwarding port

    # Establish SSH connection
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    print(f"Connecting to {SSH_HOST} via SSH...")
    client.connect(SSH_HOST, port=SSH_PORT, username=SSH_USER, password=SSH_PASSWORD)
    print("✅ SSH connection established")

    # Forward MySQL port
    transport = client.get_transport()
    forward_tunnel(local_port, MYSQL_HOST, MYSQL_PORT, transport)

    # Connect to MySQL
    print("Connecting to MySQL database through SSH tunnel...")
    conn = mysql.connector.connect(
        host="127.0.0.1",
        port=local_port,
        user=MYSQL_USER,
        password=MYSQL_PASSWORD,
        database=MYSQL_DB
    )
    print("✅ MySQL connection established")

    return client, conn


# ---------------------- #
#     Fetch Data         #
# ---------------------- #
def fetch_stores(conn, limit=10):
    """Fetch store names and coordinates."""
    cursor = conn.cursor()
    cursor.execute(f"""
        SELECT id, name, ST_Y(location) AS latitude, ST_X(location) AS longitude
        FROM store
        LIMIT {limit};
    """)
    rows = cursor.fetchall()
    return [{"id": r[0], "name": r[1], "lat": r[2], "lon": r[3]} for r in rows]


# ---------------------- #
#   Main Computation     #
# ---------------------- #
def run_calculation_via_ssh(start_lat, start_lon, limit=10):
    """Fetch stores and calculate shortest route."""
    ssh_client, conn = connect_via_ssh()
    stores = fetch_stores(conn, limit)
    conn.close()
    ssh_client.close()

    if not stores:
        print("⚠️ No stores found in database.")
        return

    print(f"\nFetched {len(stores)} stores from the database:")
    for s in stores:
        print(f" - {s['name']} ({s['lat']:.4f}, {s['lon']:.4f})")

    start_point = (start_lat, start_lon)
    store_points = [(s['lat'], s['lon']) for s in stores]

    route, total_distance = find_shortest_route(start_point, store_points)

    print("\n📍 Optimized Route:")
    for step in route:
        print(f"  From ({step['from'][0]:.4f}, {step['from'][1]:.4f}) "
              f"→ To ({step['to'][0]:.4f}, {step['to'][1]:.4f}) "
              f"= {step['distance']:.2f} mi")

    print(f"\n🚗 Total Distance: {total_distance:.2f} miles")


